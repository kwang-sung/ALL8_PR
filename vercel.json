{
  "redirects": [
    {
      "source": "/((?!downloads/).*)",
      "has": [{ "type": "host", "value": "all8-pr.vercel.app" }],
      "destination": "https://guide.goldensurfer.kr/$1",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/downloads/(.*)",
      "headers": [
        { "key": "Access-Control-Allow-Origin", "value": "*" },
        { "key": "Access-Control-Allow-Methods", "value": "GET" }
      ]
    }
  ]
}